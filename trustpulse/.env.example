# TRUSTPULSE AI — environment configuration.
#
#   cp .env.example .env
#
# Every threshold and weight below is overridable; nothing is hard-coded in the
# trust engine. Values not listed here fall back to
# `shared/constants/trust_model.json`.

# ------------------------------------------------------------------ platform
TRUSTPULSE_ENVIRONMENT=production          # development | production
TRUSTPULSE_API_PORT=8000
TRUSTPULSE_WEB_PORT=5173

# Development auth fallback (tenant header only, no credential).
# NEVER enable this in production.
ALLOW_DEVELOPMENT_AUTH_FALLBACK=false

# ------------------------------------------------------------ datastores
TRUSTPULSE_DB_USER=trustpulse
TRUSTPULSE_DB_PASSWORD=change_me_in_env
TRUSTPULSE_DB_NAME=trustpulse
TRUSTPULSE_DB_PORT=5432
TRUSTPULSE_REDIS_PASSWORD=change_me_redis_env
TRUSTPULSE_REDIS_PORT=6379

# Overridden by docker-compose; set manually only for a non-Docker backend.
# DATABASE_URL=postgresql+asyncpg://trustpulse:change_me_in_env@localhost:5432/trustpulse
# REDIS_URL=redis://:change_me_redis_env@localhost:6379/0

# SQLite fallback for local development without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./trustpulse.db

# ------------------------------------------------------------ trust model
# Where the declarative trust model lives (weights, bands, hysteresis, action
# risk catalogue). `SHARED_DIR` must contain `constants/trust_model.json`;
# `TRUST_MODEL_CONFIG_PATH` overrides the whole file path instead.
# Resolution order: TRUST_MODEL_CONFIG_PATH, then <repo>/shared, then $SHARED_DIR.
SHARED_DIR=/app/shared
# TRUST_MODEL_CONFIG_PATH=/absolute/path/to/trust_model.json

# Per-factor weight overrides. Weights are renormalised at runtime, so they do
# not have to sum to 1. Omit to use the JSON defaults.
# TCI_WEIGHT_IDENTITY=0.15
# TCI_WEIGHT_DEVICE=0.20
# TCI_WEIGHT_BEHAVIOR=0.30
# TCI_WEIGHT_NETWORK=0.15
# TCI_WEIGHT_SESSION=0.10
# TCI_WEIGHT_HISTORY=0.10

# TCI used before any behavioral observation exists.
# TCI_COLD_START=62

# Trust state band floors (must be strictly decreasing).
# TRUST_STATE_TRUSTED_MIN=85
# TRUST_STATE_DEGRADED_MIN=70
# TRUST_STATE_SUSPICIOUS_MIN=50
# TRUST_STATE_CRITICAL_MIN=30
# TRUST_STATE_BLOCKED_MIN=0

# Per-action risk overrides, 0-100 (clamped). Pattern: ACTION_RISK_<ACTION_NAME>
# ACTION_RISK_CREATE_API_KEY=90
# ACTION_RISK_DELETE_RESOURCE=95

# Free-form JSON merged over the base config (deep merge, arrays replaced).
# TRUST_MODEL_OVERRIDES={"hysteresis":{"escalation_confirmations":3}}

# ------------------------------------------------------------------ telemetry
TELEMETRY_ASYNC_PROCESSING=true
MAX_PAYLOAD_BYTES=1048576

# NOTE: rejection of raw behavioral data (typed characters, clipboard, text)
# is NOT configurable — it is always a 422. There is deliberately no flag to
# turn it off.

# ------------------------------------------------------------------- demo
# Demo integration credentials created by `scripts/seed_demo.py`.
# In production the browser must never hold an API key — TrustDev would call
# TRUSTPULSE server-to-server instead.
TRUSTPULSE_DEMO_TENANT=trustdev-demo
TRUSTPULSE_DEMO_API_KEY=tp_demo_trustpulse_key_0001
TRUSTPULSE_DEMO_PUBLIC_KEY=pk_trustdev_demo_0001

# ------------------------------------------------------------------ frontend
# Build-time only (Vite inlines these into the bundle).
VITE_TRUSTPULSE_API_KEY=tp_demo_trustpulse_key_0001
VITE_TRUSTPULSE_TENANT=trustdev-demo
# Dev-server proxy target; defaults to http://localhost:8000.
# VITE_PROXY_TARGET=http://localhost:8000
