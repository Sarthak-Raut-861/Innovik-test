# TrustPulse backend configuration (copy to .env and fill real values)
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL is authoritative. Use asyncpg in production.
DATABASE_URL=postgresql+asyncpg://trustpulse:CHANGE_ME@localhost:5432/trustpulse
REQUIRE_POSTGRES=true

# Redis is temporary state / replay / rate-limits / background queue.
REDIS_URL=redis://:CHANGE_ME_REDIS@localhost:6379/0
REDIS_REPLAY_TTL_SECONDS=86400
REDIS_SESSION_TTL_SECONDS=3600

# Security
MAX_PAYLOAD_BYTES=1048576
MAX_BATCH_PACKETS=50
MAX_CLOCK_SKEW_SECONDS=300
RATE_LIMIT_TELEMETRY_PER_MINUTE=120
RATE_LIMIT_TELEMETRY_PER_SESSION_PER_MINUTE=60
RATE_LIMIT_RISK_PER_MINUTE=240

# Authentication. NEVER leave true in production.
ALLOW_DEVELOPMENT_AUTH_FALLBACK=false

# Background telemetry processing
TELEMETRY_ASYNC_PROCESSING=true
TELEMETRY_QUEUE_MAX_SIZE=10000

# Confidence thresholds
COLD_START_CONFIDENCE=30
HIGH_CONFIDENCE_THRESHOLD=80
MODERATE_CONFIDENCE_THRESHOLD=60
GUARDED_CONFIDENCE_THRESHOLD=30
LOW_CONFIDENCE_MAX=30

# CORS (restrict in production)
BACKEND_CORS_ORIGINS=["https://app.example.com"]
TRUSTED_HOSTS=["api.trustpulse.example.com"]
